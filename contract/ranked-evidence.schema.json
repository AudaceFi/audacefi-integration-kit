{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["protocol", "evidence"],
  "additionalProperties": false,
  "properties": {
    "protocol": { "const": "audacefi.bench.ranked-evidence.v1" },
    "evidence": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["trade", "leaderboard"],
          "additionalProperties": false,
          "properties": {
            "trade": { "$ref": "#/$defs/trade" },
            "leaderboard": { "$ref": "#/$defs/leaderboard" }
          }
        }
      ]
    }
  },
  "$defs": {
    "id": { "type": "string", "format": "uuid" },
    "signature": { "type": "string", "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,88}$" },
    "amount": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "trade": {
      "type": "object",
      "required": [
        "operationKey", "seasonId", "accountId", "actor", "category", "playerPublicKey",
        "intentId", "txid", "amountInRaw", "amountOutRaw", "feeRaw"
      ],
      "additionalProperties": false,
      "properties": {
        "operationKey": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" },
        "seasonId": { "$ref": "#/$defs/id" },
        "accountId": { "$ref": "#/$defs/id" },
        "actor": { "enum": ["trading_bot", "ai_agent"] },
        "category": { "const": "crypto-bro" },
        "playerPublicKey": { "type": "string", "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$" },
        "intentId": { "$ref": "#/$defs/id" },
        "txid": { "$ref": "#/$defs/signature" },
        "amountInRaw": { "$ref": "#/$defs/amount" },
        "amountOutRaw": { "$ref": "#/$defs/amount" },
        "feeRaw": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" }
      }
    },
    "leaderboard": {
      "type": "object",
      "required": ["seasonId", "accountId", "category", "division", "rank", "asOf", "includedIntentId", "includedTxid"],
      "additionalProperties": false,
      "properties": {
        "seasonId": { "$ref": "#/$defs/id" },
        "accountId": { "$ref": "#/$defs/id" },
        "category": { "const": "crypto-bro" },
        "division": { "enum": ["A", "B", "C"] },
        "rank": { "type": "integer", "minimum": 1, "maximum": 1000000000000 },
        "asOf": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "includedIntentId": { "$ref": "#/$defs/id" },
        "includedTxid": { "$ref": "#/$defs/signature" }
      }
    }
  }
}
