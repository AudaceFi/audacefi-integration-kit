    "/v1/me/allowlist": {
      "get": {
        "summary": "Read consumed negotiable-mint projection for this API-key account in real mode",
        "description": "API-key read scope. Query category is snake_case. The response season/category must match the operator; extra token metadata is ignored. A read request does not enroll an account or issue a key.",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "degen",
                "crypto_bro",
                "whale"
              ]
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "const": "real"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consumed projection; no independent market-data timestamp is supplied by this route.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "seasonId",
                    "category",
                    "allowlistFrozen",
                    "tokens"
                  ],
                  "properties": {
                    "seasonId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "category": {
                      "type": "string",
                      "enum": [
                        "degen",
                        "crypto_bro",
                        "whale"
                      ]
                    },
                    "allowlistFrozen": {
                      "type": "boolean"
                    },
                    "tokens": {
                      "type": "array",
                      "maxItems": 2048,
                      "items": {
                        "type": "object",
                        "required": [
                          "mint",
                          "decimals",
                          "exempt",
                          "eligible"
                        ],
                        "properties": {
                          "mint": {
                            "type": "string",
                            "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
                          },
                          "decimals": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0,
                            "maximum": 9
                          },
                          "exempt": {
                            "type": "boolean"
                          },
                          "eligible": {
                            "type": "boolean"
                          },
                          "symbol": {
                            "type": ["string", "null"],
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,15}$"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Revocable API key supplied in memory; read for reads, execute for writes. Separate from account session and player signing."
      }
    },
    "schemas": {
      "Intent": {
        "type": "object",
        "required": [
          "intentId",
          "status",
          "replayed"
        ],
        "properties": {
          "intentId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "const": "built"
          },
          "replayed": {
            "type": "boolean"
          },
          "inputBinding": {
            "const": "audacefi.swap-intent-input.v1",
            "description": "Present for an opted-in request whose stored intent exactly matches the authenticated account, key and admitted fields."
          }
        }
      },
      "IntentInput": {
        "type": "object",
        "required": [
          "seasonId",
          "category",
          "tokenInMint",
          "tokenOutMint",
          "amountIn",
          "idempotencyKey",
          "surface"
        ],
        "properties": {
          "seasonId": {
            "type": "string",
            "format": "uuid"
          },
          "category": {
            "enum": [
              "degen",
              "crypto_bro",
              "whale"
            ]
          },
          "tokenInMint": {
            "type": "string",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
          },
          "tokenOutMint": {
            "type": "string",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
          },
          "amountIn": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "surface": {
            "const": "api"
          },
          "inputBinding": {
            "const": "audacefi.swap-intent-input.v1",
            "description": "Request verification against the exact stored intent on an idempotent retry. A mismatched stored request is refused."
          }
        }
      },
      "Quote": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "intentId",
              "quoteId",
              "amountInRaw",
              "expiresAt",
              "ttlSeconds",
              "mintMainnet",
              "mintDevnet",
              "direction",
              "price",
              "expo",
              "priceUsd"
            ],
            "properties": {
              "intentId": {
                "type": "string",
                "format": "uuid"
              },
              "quoteId": {
                "type": "string",
                "format": "uuid"
              },
              "amountInRaw": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,19}$",
                "description": "Positive u64, validated at runtime"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              },
              "ttlSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300
              },
              "mintMainnet": {
                "type": "string",
                "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
              },
              "mintDevnet": {
                "type": "string",
                "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
              },
              "direction": {
                "enum": [
                  "buy",
                  "sell"
                ]
              },
              "price": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,19}$",
                "description": "Positive u64, validated at runtime"
              },
              "expo": {
                "type": "integer",
                "minimum": -18,
                "maximum": 18
              },
              "priceUsd": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          {
            "type": "object",
            "required": [
              "intentId",
              "quoteId",
              "amountInRaw",
              "expiresAt",
              "ttlSeconds",
              "kind",
              "quoteIdOut",
              "mintInMainnet",
              "mintInDevnet",
              "mintOutMainnet",
              "mintOutDevnet",
              "priceIn",
              "priceOut",
              "amountOutGrossRaw",
              "feeRaw",
              "feeBps",
              "amountOutNetRaw"
            ],
            "properties": {
              "intentId": {
                "type": "string",
                "format": "uuid"
              },
              "quoteId": {
                "type": "string",
                "format": "uuid"
              },
              "amountInRaw": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,19}$",
                "description": "Positive u64, validated at runtime"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              },
              "ttlSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300
              },
              "kind": {
                "const": "route"
              },
              "quoteIdOut": {
                "type": "string",
                "format": "uuid"
              },
              "mintInMainnet": {
                "type": "string",
                "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
              },
              "mintInDevnet": {
                "type": "string",
                "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
              },
              "mintOutMainnet": {
                "type": "string",
                "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
              },
              "mintOutDevnet": {
                "type": "string",
                "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
              },
              "priceIn": {
                "type": "object",
                "required": [
                  "price",
                  "expo",
                  "priceUsd"
                ],
                "properties": {
                  "price": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19}$",
                    "description": "Positive u64, validated at runtime"
                  },
                  "expo": {
                    "type": "integer",
                    "minimum": -18,
                    "maximum": 18
                  },
                  "priceUsd": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              "priceOut": {
                "type": "object",
                "required": [
                  "price",
                  "expo",
                  "priceUsd"
                ],
                "properties": {
                  "price": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19}$",
                    "description": "Positive u64, validated at runtime"
                  },
                  "expo": {
                    "type": "integer",
                    "minimum": -18,
                    "maximum": 18
                  },
                  "priceUsd": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              "amountOutGrossRaw": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,19}$",
                "description": "Positive u64, validated at runtime"
              },
              "feeRaw": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              },
              "feeBps": {
                "const": 20
              },
              "amountOutNetRaw": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,19}$",
                "description": "Positive u64, validated at runtime"
              }
            }
          }
        ]
      },
      "Submission": {
        "type": "object",
        "required": [
          "protocol",
          "intentId",
          "quoteId",
          "quoteOutId",
          "messageHash",
          "playerSignature",
          "playerPublicKey",
          "txid",
          "recordedAt",
          "state"
        ],
        "properties": {
          "protocol": {
            "const": "audacefi.bench.submission.v1"
          },
          "intentId": {
            "type": "string",
            "format": "uuid"
          },
          "quoteId": {
            "type": "string",
            "format": "uuid"
          },
          "quoteOutId": {
            "type": [
              "string",
              "null"
            ]
          },
          "messageHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "playerSignature": {
            "type": "string"
          },
          "playerPublicKey": {
            "type": "string",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
          },
          "txid": {
            "type": "string"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "enum": [
              "SUBMITTED",
              "RECORDED",
              "UNKNOWN"
            ]
          }
        }
      },
      "SubmissionLookup": {
        "type": "object",
        "required": [
          "protocol",
          "submission"
        ],
        "properties": {
          "protocol": {
            "const": "audacefi.bench.submission.v1"
          },
          "resultStatus": {
            "enum": [null, "confirmed", "failed"],
            "description": "The durable submission's stored terminal product result, or explicit null when no terminal result is recorded. A legacy deployment may omit the field."
          },
          "submission": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Submission"
              }
            ]
          }
        }
      },
      "SignatureInput": {
        "type": "object",
        "required": [
          "signature"
        ],
        "properties": {
          "signature": {
            "type": "string"
          }
        }
      },
      "SubmitInput": {
        "type": "object",
        "required": [
          "quoteId",
          "transaction"
        ],
        "properties": {
          "quoteId": {
            "type": "string",
            "format": "uuid"
          },
          "quoteOutId": {
            "type": "string",
            "format": "uuid"
          },
          "transaction": {
            "type": "string",
            "minLength": 64,
            "maxLength": 1800,
            "contentEncoding": "base64"
          }
        }
      }
    }
  }
}
