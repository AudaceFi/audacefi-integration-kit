{
  "openapi": "3.1.0",
  "info": {
    "title": "AudaceFi starter consumer contract",
    "version": "1.0.0",
    "description": "Source-reviewed consumer shapes. Public source contract; optional durable routes are not certified as deployed. No servers or credentials embedded."
  },
  "paths": {
    "/v1/me": {
      "get": {
        "operationId": "readOwnOperatorIdentity",
        "description": "Read the active account and the scope of the presented API key. Official execution binds this response to the same bearer used for the protected request.",
        "security": [{ "ApiKeyBearer": [] }],
        "responses": {
          "200": {
            "description": "Account identity and onboarding status. The client consumes only the fields shown here.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["account", "onboardingComplete", "credentialScopes"],
                  "properties": {
                    "account": {
                      "type": "object",
                      "required": ["id", "status", "participantType", "participantTypeDeclaredAt"],
                      "properties": {
                        "id": { "type": "string", "format": "uuid" },
                        "status": { "type": "string" },
                        "participantType": { "enum": ["trading_bot", "ai_agent"] },
                        "participantTypeDeclaredAt": { "type": ["string", "null"], "format": "date-time" }
                      }
                    },
                    "onboardingComplete": { "type": "boolean" },
                    "credentialScopes": { "type": "array", "uniqueItems": true, "items": { "enum": ["read", "execute"] } }
                  }
                }
              }
            }
          },
          "401": { "description": "Authentication refused" },
          "403": { "description": "Scope or account access refused" }
        }
      }
    },
    "/v1/me/state": {
      "get": {
        "operationId": "readOwnState",
        "security": [
          {
            "ApiKeyBearer": []
          }
        ],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "degen",
                "crypto-bro",
                "whale"
              ]
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "real",
                "demo"
              ],
              "default": "real"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "State with explicit unavailable sections. asOf is assembly time, not observation time.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./read-state.schema.json"
                }
              }
            }
          },
          "400": {
            "description": "BAD_REQUEST query"
          },
          "401": {
            "description": "Authentication refused"
          },
          "403": {
            "description": "Scope or account access refused"
          },
          "429": {
            "description": "Deployment quota exceeded; do not busy-loop"
          }
        }
      }
    },
